<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ data extraction rules.
     NERV holds the wallet seed encrypted inside the app sandbox; we
     never back it up to the cloud (Android Auto-Backup, D2D, etc.).
     The only state we permit to leave the device is the app's
     preferences (theme, last-active screen) which contain no
     cryptographic material. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>