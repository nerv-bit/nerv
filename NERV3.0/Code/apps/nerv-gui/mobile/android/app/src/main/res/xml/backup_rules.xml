<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 backup rules.
     NERV explicitly opts out of cloud backup to ensure the seed
     never leaves the device. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>