<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (Compose takes over content). -->
    <style name="Theme.Nerv" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/nerv_bg</item>
        <item name="android:navigationBarColor">@color/nerv_bg</item>
        <item name="android:windowBackground">@color/nerv_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Splash theme (Android 12+ splashscreen API). The icon and
         background colors come from `colors.xml` so the splash matches
         the supplied NERV logo. -->
    <style name="Theme.Nerv.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nerv_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Nerv</item>
    </style>
</resources>